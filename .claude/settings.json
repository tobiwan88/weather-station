{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/ws.sh 'cd weather-station && scripts/build-gate.sh')",
      "Bash(scripts/ws.sh 'cd weather-station && pre-commit run --all-files')",
      "Bash(git branch --show-current)",
      "Bash(scripts/build-gate.sh *)",
      "Bash(scripts/check-standards.sh *)",
      "Bash(scripts/run-tests.sh *)",
      "Bash(west build *)",
      "Bash(west twister *)",
      "Bash(pre-commit run *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ],
    "deny": [
      "Bash(git add .)",
      "Bash(git add -A *)",
      "Bash(git add -A)",
      "Bash(git add --all *)",
      "Bash(git add --all)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read(./keys/**)",
      "Bash(git branch -D *)",
      "Bash(cat keys/*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/check-edit.sh",
            "timeout": 10,
            "statusMessage": "Checking banned patterns..."
          }
        ]
      }
    ]
  }
}
