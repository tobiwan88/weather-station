/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Gateway DT overlay for frdm_mcxn947 — real hardware.
 *
 * Sensors:
 *   - BME688 indoor environmental sensor on Arduino I2C (T/P/H/gas)
 *
 * LoRa:
 *   - Flexcomm5 LPUART5 wired to Wio-E5 Mini co-processor
 *
 * UIDs 0x0001–0x000F are reserved for gateway local sensors.
 * UIDs 0x0011–0x001F are reserved for gateway outdoor sensors.
 * UIDs 0x0021+ are for remote sensor nodes.
 *
 * No display — LVGL is disabled on this target.
 */

/* BME688 indoor environmental sensor on Arduino I2C (D14=SDA, D15=SCL) */
&arduino_i2c {
	bme688_indoor: bme688@76 {
		compatible = "bosch,bme680";
		reg = <0x76>;
	};
};

/* Flexcomm5 LPUART5 — LoRa co-processor (Wio-E5 Mini)
 * TX: PT1_4 (FC5_P0), RX: PT1_5 (FC5_P1) */
&pinctrl {
	pinmux_flexcomm5_lpuart: pinmux_flexcomm5_lpuart {
		group0 {
			pinmux = <FC5_P0_PIO1_4>,
				 <FC5_P1_PIO1_5>;
			slew-rate = "fast";
			drive-strength = "low";
			input-enable;
			bias-pull-up;
		};
	};
};

&flexcomm5 {
	status = "okay";
};

&flexcomm5_lpuart5 {
	current-speed = <9600>;
	pinctrl-0 = <&pinmux_flexcomm5_lpuart>;
	pinctrl-names = "default";
	status = "okay";
};
