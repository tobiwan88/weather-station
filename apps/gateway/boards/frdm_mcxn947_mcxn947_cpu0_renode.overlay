/*
 * Renode-specific DTS overlay for FRDM-MCXN947.
 *
 * Disables the external W25Q64 SPI NOR flash because the Renode .repl models
 * it as bare Memory.MappedMemory, which cannot respond to SPI IP commands.
 * The flash_mcux_flexspi_nor driver hangs in FLEXSPI_TransferBlocking().
 *
 * Internal flash (FTFE at 0x10000000) is unaffected — MCUboot slots and
 * FOTA continue to work.
 */

&ext_flash_ctrl {
	status = "disabled";
};

&w25q64jvssiq {
	status = "disabled";
};
