/*
 * SPDX-License-Identifier: Apache-2.0
 *
 * Sensor-node DT overlay for native_sim.
 *
 * Defines two fake sensors for node_0:
 *   - One temperature sensor
 *   - One humidity sensor
 *
 * Sensor UIDs are assigned at build time via Kconfig:
 *   CONFIG_FAKE_TEMPERATURE_UID_BASE (default 0x0021)
 *   CONFIG_FAKE_HUMIDITY_UID_BASE (default 0x0022)
 */

/ {
	fake_temp_node: fake-temp-node {
		compatible = "fake,temperature";
		initial-value-mdegc = <5000>;
		status = "okay";
	};

	fake_hum_node: fake-hum-node {
		compatible = "fake,humidity";
		initial-value-mpct = <70000>;
		status = "okay";
	};

	fake_lora0: fake-lora-radio {
		compatible = "fake,lora-radio";
		status = "okay";
	};

	aliases {
		lora0 = &fake_lora0;
	};
};
