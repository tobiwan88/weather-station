menuconfig FOTA_CONFIRM
	bool "Auto-confirm firmware image after successful boot"
	depends on BOOTLOADER_MCUBOOT && IMG_MANAGER
	help
	  Schedules boot_write_img_confirmed() after a configurable settle
	  delay at SYS_INIT APPLICATION priority 99 (after all other libs
	  have initialised). Without confirmation, MCUboot treats the running
	  image as a test image and reverts to the previous slot on the next
	  reset.

if FOTA_CONFIRM

config FOTA_CONFIRM_DELAY_S
	int "Settle delay before confirming image (seconds)"
	default 5
	range 1 60
	help
	  How long to wait after SYS_INIT APPLICATION 99 before calling
	  boot_write_img_confirmed(). Allows HTTP dashboard, MQTT, and SNTP
	  to bind their sockets before the image is marked permanent.
	  Note: boot_write_img_confirmed() calls flash_area_write() on the
	  system work queue; keep the delay long enough that other work queue
	  consumers (MQTT reconnect, SNTP) have completed their init writes.

config FOTA_CONFIRM_REQUIRE_SENSOR_EVENT
	bool "Confirm only after a sensor event has been published"
	depends on SENSOR_EVENT
	select ZBUS_CHANNEL_PUBLISH_STATS
	help
	  Before confirming, require at least one event on sensor_event_chan.
	  A new image that boots but never produces sensor data is then not
	  confirmed, so MCUboot reverts it on the next reset. Only enable this
	  when a sensor reports well within
	  FOTA_CONFIRM_DELAY_S * (FOTA_CONFIRM_MAX_RETRIES + 1) seconds.

config FOTA_CONFIRM_MAX_RETRIES
	int "Health-check retries before giving up on confirmation"
	default 6
	range 0 60
	help
	  Number of times the confirm work is rescheduled (every
	  FOTA_CONFIRM_DELAY_S seconds) while the health check fails. After
	  the last retry the image is left unconfirmed and MCUboot reverts it
	  on the next reset.

module = FOTA_CONFIRM
module-str = FOTA_CONFIRM
source "subsys/logging/Kconfig.template.log_config"

endif # FOTA_CONFIRM
