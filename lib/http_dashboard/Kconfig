menuconfig HTTP_DASHBOARD
	bool "HTTP weather dashboard (Chart.js timeseries + config page)"
	depends on HTTP_SERVER
	depends on SENSOR_EVENT
	depends on SENSOR_REGISTRY
	select NET_TCP
	select CONFIG_CMD
	select LOCATION_REGISTRY
	help
	  Serves a browser-accessible dashboard on an HTTP port with two pages:
	    /        — live Chart.js timeseries for temperature and humidity
	    /config  — configuration page (trigger interval, SNTP resync)
	  JSON APIs at /api/data and /api/config support the pages.

if HTTP_DASHBOARD

config HTTP_DASHBOARD_PORT
	int "Listening TCP port"
	default 8080
	depends on HTTP_DASHBOARD

config HTTP_DASHBOARD_HISTORY_SIZE
	int "Samples retained per sensor per type (ring buffer)"
	default 20
	depends on HTTP_DASHBOARD

config HTTP_DASHBOARD_MAX_SENSORS
	int "Max sensor x type slots (uid + type = one slot)"
	default 16
	depends on HTTP_DASHBOARD

config HTTP_DASHBOARD_JSON_BUF_SIZE
	int "Output buffer for GET /api/data (bytes)"
	default 30720
	range 2048 65536
	depends on HTTP_DASHBOARD
	help
	  Worst-case /api/data size with the default MAX_SENSORS (16) and
	  HISTORY_SIZE (20), with user metadata enabled:
	    per slot = 95 + 6 * (NAME_LEN + LOCATION_LEN + DESC_LEN) + HISTORY_SIZE * 48
	             = 95 + 6 * (32 + 32 + 64) + 20 * 48 = 1823 bytes
	    total    = MAX_SENSORS * per_slot + 15      = 29183 bytes
	  Rounded up to 30 KiB. Responses that do not fit return HTTP 500.

config HTTP_DASHBOARD_AUTH
	bool "Enable username/password login and bearer token authentication"
	depends on HTTP_DASHBOARD
	select HTTP_SERVER_CAPTURE_HEADERS
	select SETTINGS
	help
	  Adds a /login page with username+password authentication (default
	  admin:admin) that issues HttpOnly session cookies for browser users.
	  Also keeps a persisted API bearer token for automation clients.
	  Use 'http_dashboard token show' to read the API token.

if HTTP_DASHBOARD_AUTH

config HTTP_DASHBOARD_AUTH_DEFAULT_USER
	string "Default username (written to settings on first boot)"
	default "admin"

config HTTP_DASHBOARD_AUTH_DEFAULT_PASS
	string "Default password (written to settings on first boot)"
	default "admin"

config HTTP_DASHBOARD_AUTH_FORCE_PW_CHANGE
	bool "Force a credential change while first-boot defaults are in use"
	default y
	help
	  While the stored credentials are still the first-boot defaults, every
	  authenticated API except login, logout and change-credentials returns
	  403 {"error":"password_change_required"}.

config HTTP_DASHBOARD_AUTH_MAX_FAILS
	int "Consecutive failed logins before throttling"
	default 5
	range 1 100
	help
	  After this many consecutive failures, POST /api/login returns 429 with
	  a Retry-After header of min(5 s * 2^(fails - N), 300 s).  The counter
	  is global (not per client) and reset by a successful login.  A LAN
	  attacker can therefore keep the owner locked out for up to 300 s at
	  a time; acceptable for a home device.

config HTTP_DASHBOARD_SESSION_COUNT
	int "Concurrent browser session slots"
	default 4
	range 1 16

config HTTP_DASHBOARD_AUTH_SHELL
	bool "Shell commands for token/user management"
	depends on SHELL
	default y
	help
	  Adds shell sub-commands:
	    http_dashboard token show   — print current API bearer token
	    http_dashboard token rotate — generate a new API token
	    http_dashboard user show    — print current dashboard username

endif # HTTP_DASHBOARD_AUTH

config HTTP_DASHBOARD_FOTA
	bool "FOTA firmware upload endpoints (/api/fota/*)"
	depends on HTTP_DASHBOARD && HTTP_DASHBOARD_AUTH
	depends on BOOTLOADER_MCUBOOT && IMG_MANAGER
	select IO_STREAM
	select IO_STREAM_FLASH
	select REBOOT
	help
	  Adds three auth-gated endpoints to the HTTP dashboard:
	    POST /api/fota/upload  — stream signed image to flash slot 1
	    POST /api/fota/apply   — mark slot 1 pending and schedule reboot
	    GET  /api/fota/status  — return slot 0/1 versions and swap state
	  Requires HTTP_DASHBOARD_AUTH — upload is always authenticated.

module = HTTP_DASHBOARD
module-str = HTTP_DASHBOARD
source "subsys/logging/Kconfig.template.log_config"

endif # HTTP_DASHBOARD
