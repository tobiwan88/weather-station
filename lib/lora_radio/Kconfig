menuconfig LORA_RADIO
	bool "LoRa radio subsystem"
	depends on ZBUS
	depends on SENSOR_EVENT
	depends on REMOTE_SENSOR
	select LORA_PROTO
	help
	  Point-to-point LoRa communication library for wireless sensor nodes.
	  Implements a custom L2 frame protocol with AES-128-GCM encryption,
	  RPC commands and FOTA relay. Nodes use pre-shared per-node keys
	  provisioned through the shell (no over-the-air pairing).

	  Uses Zephyr's LoRa driver API (<zephyr/drivers/lora.h>). The radio
	  driver can be Zephyr's built-in SX126x driver (real hardware) or a
	  fake driver (native_sim testing). Set CONFIG_LORA_RADIO_DEV_NAME
	  to match the device name registered by the radio driver.

if LORA_RADIO

config LORA_RADIO_FAKE
	bool "Fake LoRa driver (native_sim only)"
	depends on BOARD_NATIVE_SIM
	default y if BOARD_NATIVE_SIM
	help
	  Compile the in-process fake LoRa driver that uses kernel FIFOs for
	  TX/RX loopback.  Requires a 'fake,lora-radio' DT node which is only
	  present in the native_sim overlay.  Must NOT be enabled for real
	  hardware targets — those use the Zephyr SX126x driver or another
	  board-supplied LoRa device.

config LORA_RADIO_DEV_NAME
	string "LoRa device name"
	default "lora0"
	help
	  Device name used with device_get_binding() to locate the LoRa radio.
	  Set to match the DT node label or driver name of your LoRa device.

config LORA_RADIO_FOTA
	bool "FOTA over LoRa"
	depends on IMG_MANAGER
	select IO_STREAM
	select IO_STREAM_FLASH
	help
	  Relays sensor-node firmware images over LoRa using windowed ACK
	  protocol. Sensor node stores received image in MCUboot slot 1.

config LORA_RADIO_FOTA_CHUNK_SIZE
	int "FOTA chunk size in bytes"
	default 227
	range 16 227
	depends on LORA_RADIO_FOTA
	help
	  Maximum payload bytes per FOTA_CHUNK frame. Must fit within the
	  LoRa packet budget at the configured spreading factor: 255 bytes
	  minus 24 bytes frame overhead minus the 4-byte chunk offset.

config LORA_RADIO_FOTA_WINDOW
	int "FOTA window size (chunks in flight)"
	default 8
	range 1 16
	depends on LORA_RADIO_FOTA
	help
	  Number of FOTA chunks sent before waiting for cumulative ACK.

config LORA_RADIO_AUTO_PUBLISH_MS
	int "Auto-publish interval in milliseconds (0 = disabled)"
	default 60000
	range 0 3600000
	help
	  When non-zero, the gateway periodically sends sensor data to remote
	  nodes on the LoRa link. Set to 0 for on-demand publishing only.

config LORA_RADIO_RX_THREAD_STACK_SIZE
	int "RX thread stack size (bytes)"
	default 2048
	help
	  Stack size for the dedicated LoRa receive thread.

config LORA_RADIO_RX_THREAD_PRIORITY
	int "RX thread cooperative priority"
	default 5
	help
	  Priority of the dedicated LoRa receive thread.

config LORA_RADIO_DEFAULT_SF
	int "Default LoRa spreading factor"
	default 10
	range 7 12
	help
	  Default spreading factor used when no per-peer override is set.

config LORA_RADIO_DEFAULT_BW
	int "Default LoRa bandwidth (kHz)"
	default 125
	help
	  Default bandwidth in kHz used when no per-peer override is set.

config LORA_RADIO_FREQ_HZ
	int "LoRa carrier frequency (Hz)"
	default 868000000
	help
	  Carrier frequency used for both RX and TX. Must be legal in your
	  region and match the sensor nodes.

config LORA_RADIO_TX_POWER
	int "LoRa TX power (dBm)"
	default 14
	range -9 22
	help
	  Transmit power applied to every gateway/bridge transmission.

config LORA_RADIO_RX_SLICE_MS
	int "RX listen slice (ms)"
	default 200
	range 20 5000
	help
	  The RX thread listens in slices of this length and releases the
	  modem between slices so lora_radio_send() can switch to TX. A
	  longer slice delays outgoing frames by up to this long.

config LORA_RADIO_REQUIRE_ENCRYPTION
	bool "Drop plaintext and unknown-node uplink frames"
	default y
	help
	  Only frames from nodes with a stored key that carry the ENCRYPTED
	  flag and authenticate are accepted. Disable only for bring-up:
	  plaintext frames are then dispatched without authentication (they
	  do not update replay state or link statistics).

config LORA_RADIO_SEQ_RESERVE
	int "Downlink sequence reservation size"
	default 64
	range 1 65536
	help
	  The downlink counter is persisted in blocks of this many values
	  (write-ahead). After a reboot it resumes at the persisted bound, so
	  up to this many values are skipped but never reused. Encrypted TX is
	  refused if the reservation cannot be persisted.

config LORA_RADIO_ALLOW_VOLATILE_SEQ
	bool "Allow a non-persistent downlink counter (test only)"
	default y if BOARD_NATIVE_SIM
	help
	  The downlink sequence counter is the AES-GCM nonce and must survive
	  reboots. If settings have no storage backend (SETTINGS_NONE) the
	  reservation cannot be persisted and encrypted TX fails closed. This
	  option lets TX continue from a RAM-only counter that restarts at 1
	  on every boot, which repeats (key, nonce) pairs across reboots.
	  Test-only: native_sim and simulators without flash. Never enable
	  on hardware.

config LORA_SENSOR_PUBLISH_INTERVAL_S
	int "Sensor node publish interval in seconds"
	default 60
	range 0 3600
	help
	  How often a sensor node should publish its readings to the gateway.

config LORA_SENSOR_KEEPALIVE_S
	int "Sensor node keep-alive interval in seconds (0 = disabled)"
	default 0
	range 0 86400
	help
	  Maximum silence interval before the sensor node sends a keep-alive.
	  0 disables keep-alive (node only publishes when data changes).

config LORA_RADIO_SESSION_MAX
	int "Maximum number of concurrent LoRa sessions"
	default 16
	range 1 64
	help
	  Pre-allocates session slots for paired remote nodes.

config LORA_RADIO_SHELL
	bool "Shell commands for LoRa radio control"
	default y
	depends on SHELL
	help
	  Adds the "lora" shell command group:
	    lora provision <node> — generate and store a per-node key
	    lora forget <node>    — remove a node session
	    lora sessions         — list sessions (no keys)
	    lora status / rpc / unpair

config LORA_RADIO_PENDING
	bool "Reliable TX subsystem (retry + ACK matching)"
	default y
	help
	  Shared reliable transmission subsystem. Provides per-session
	  pending-request slots with retry timers, randomized exponential
	  backoff, and ACK matching. Used by RPC and FOTA.

config LORA_RADIO_RETRY_MAX
	int "Max retries per pending request"
	default 3
	range 1 5
	depends on LORA_RADIO_PENDING
	help
	  Maximum number of retransmission attempts before returning
	  -ETIMEDOUT to the caller.

config LORA_RADIO_RETRY_TIMEOUT_BASE_MS
	int "Base retry timeout in milliseconds"
	default 5000
	depends on LORA_RADIO_PENDING
	help
	  Base timeout scaled by spreading factor. Actual timeout =
	  BASE * SF_factor with ±30% randomization (jitter).
	  SF7=1×, SF8=1.4×, SF9=2×, SF10=3×, SF11=4.4×, SF12=6×.

config LORA_RADIO_RPC_RETRY
	bool "Enable RPC retry"
	default y
	select LORA_RADIO_PENDING
	help
	  RPC commands use ACK-based delivery with up to 3 retries.
	  Requires LORA_RADIO_PENDING.

config LORA_RADIO_FOTA_RETRY_MS
	int "FOTA chunk retry timer in milliseconds"
	default 2000
	depends on LORA_RADIO_FOTA
	help
	  Retry timer for individual FOTA chunks. Each unacknowledged
	  chunk is retried after this delay.

config LORA_RADIO_FOTA_COOLDOWN_S
	int "Cooldown after 3 consecutive FOTA chunk timeouts (seconds)"
	default 30
	depends on LORA_RADIO_FOTA
	help
	  Pause duration after 3 consecutive chunk timeouts before
	  resuming the FOTA transfer.

module = LORA_RADIO
module-str = LORA_RADIO
source "subsys/logging/Kconfig.template.log_config"

endif # LORA_RADIO
