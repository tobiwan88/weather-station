menuconfig SENSOR_NODE_TX
	bool "Sensor Node LoRa TX"
	depends on LORA_NODE
	select SENSOR_EVENT
	select CONFIG_CMD
	default y
	help
	  Zbus consumer that accumulates env_sensor_data events and transmits
	  them as compact 5-byte LoRa readings on a configurable interval.

if SENSOR_NODE_TX

config SENSOR_NODE_TX_INTERVAL_S
	int "TX interval in seconds"
	default 60
	range 4 3600
	help
	  How often to transmit accumulated sensor readings via LoRa.

config SENSOR_NODE_TX_MAX_READINGS
	int "Max readings per TX batch"
	default 20
	range 4 64
	help
	  Maximum number of sensor readings to buffer before transmission.
	  Limited by the LoRa payload budget at the configured spreading factor.

config SENSOR_NODE_TX_LOG_LEVEL
	int "Log level"
	default 3

module = SENSOR_NODE_TX
module-str = SENSOR_NODE_TX
source "subsys/logging/Kconfig.template.log_config"

endif # SENSOR_NODE_TX
